<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- nur für den Download der AutoEq-Kopfhörerkorrekturen -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- nur für den Update-Knopf: neue Version von GitHub installieren -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Live-Spektrum (Android koppelt die Klanganalyse an diese Berechtigung) und Boxen einmessen -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EqGold">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Damit Musik-Apps (z. B. Spotify -> Einstellungen -> Equalizer) diese App öffnen können -->
            <intent-filter>
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CATEGORY_CONTENT_MUSIC" />
            </intent-filter>
            <!-- Langes Drücken auf eine Schnellkachel öffnet die App -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Hörtest -->
        <activity
            android:name=".HearingTestActivity"
            android:exported="false"
            android:label="Hörtest" />

        <!-- Boxen einmessen -->
        <activity
            android:name=".RoomMeasureActivity"
            android:exported="false"
            android:label="Boxen einmessen"
            android:screenOrientation="portrait" />

        <!-- Unsichtbare Hilfs-Activity: Einschalten aus dem Widget -->
        <activity
            android:name=".StartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EqGold.NoDisplay" />

        <!-- Homescreen-Widget -->
        <receiver
            android:name=".EqWidget"
            android:exported="false"
            android:label="Equalizer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eq_widget_info" />
        </receiver>

        <service
            android:name=".EqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Systemweiter Audio-Equalizer" />
        </service>

        <!-- Schnelleinstellungs-Kacheln -->
        <service
            android:name=".EqToggleTile"
            android:exported="true"
            android:icon="@drawable/ic_eq"
            android:label="Equalizer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".EqProfileTile"
            android:exported="true"
            android:icon="@drawable/ic_eq"
            android:label="EQ-Profil"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Musik-Apps melden hier ihre Audio-Sessions an und ab -->
        <receiver
            android:name=".SessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Rückmeldung des Installers beim Update aus der App -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
